{
  "name": "Offer",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "base_price": {
      "type": "number"
    },
    "previous_price": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "url": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "product_id",
    "product_slug",
    "store_name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}