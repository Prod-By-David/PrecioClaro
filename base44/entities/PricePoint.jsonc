{
  "name": "PricePoint",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "store_name": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "product_id",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}